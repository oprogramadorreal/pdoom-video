{
  "name": "app",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "check:pt-br": "bun scripts/check-pt-br.ts",
    "render:pt-br": "bun scripts/render.ts video --lang pt-BR --samples auto --shutter 0.2",
    "plates:pt-br": "bun scripts/render.ts plates --lang pt-BR --only open,loss,room,shoggoth,spacetime,ascent,bureau,leftturn,paperclips,fuse,stack,dense,loom,ilya"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "opentype.js": "^2.0.0",
    "three": "^0.186.0"
  }
}
